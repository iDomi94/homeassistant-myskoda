 from myskoda.models.event import OperationStatus
 from myskoda.models.info import CapabilityId
 
@@ -48,6 +49,7 @@ async def async_setup_entry(
         available_entities=[
             AddBlueRange,
             BatteryPercentage,
+            DrivingScoreSensor,
